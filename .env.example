# ── LLM APIs ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...            # opcional
OPENROUTER_API_KEY=sk-or-...     # opcional
DEEPSEEK_API_KEY=sk-...          # opcional
QWEN_API_KEY=sk-...              # opcional

# ── Base de datos ──────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_prod

# ── Redis ──────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -hex 16
REDIS_PASSWORD=cambiar_antes_de_deploy

# ── Auth ───────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_very_long_secret_in_production
ADMIN_PASSWORD=cambiar_esto_antes_de_deploy
EMAIL_RETURN_TOKENS_IN_RESPONSE=false

# SMTP / email saliente
SMTP_HOST=smtp.tuempresa.com
SMTP_PORT=587
SMTP_USERNAME=notificaciones@tuempresa.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=notificaciones@tuempresa.com
SMTP_FROM_NAME=Agentica
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=20

# Generar con: python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=

# ── App ────────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
PRODUCT_PROFILE=saas
CORS_ORIGINS='["http://localhost:5173"]'
BASE_DOMAIN=localhost

# Modelo usado internamente por el wizard/selector/optimizer.
BUILDER_PROVIDER=anthropic
BUILDER_MODEL=claude-sonnet-4-5
BUILDER_BASE_URL=
BUILDER_API_KEY=

# Frontend build (producción detrás de /agentica)
VITE_API_URL=/agentica
VITE_WS_URL=wss://axenova.com/agentica

# ── Canales (opcional en dev) ─────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TELEGRAM_BOT_TOKEN=

# ── Herramientas (opcional) ───────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...          # para web_search tool

# ── Moodle (opcional) ─────────────────────────────────────────────────────────
MOODLE_URL=http://localhost:8080
MOODLE_API_KEY=moodle-ai-query-secret-key-2026
# Mapea user_id de Agentica -> user_id de Moodle, por ejemplo {"agentica-user-id":"42"}
MOODLE_USER_MAP_JSON={}
